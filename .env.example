# Copy to `.env.gemini` (or `.env`) and fill in. Both are gitignored; only this example
# is committed. Nothing here is required to run retrieval — the search path, the whole
# evaluation harness and the citation verifier all work with no credentials at all.

# ---- generation (optional) -------------------------------------------------------
# Without this the service still starts, retrieves, and serves the dashboard; it reports
# `generator_available: false` and answers nothing. Free tier is 20 requests per day per
# model, and a rejected request still spends one.
GEMINI_API_KEY=

# ---- cost reporting (optional) ---------------------------------------------------
# USD per million tokens. Cost is reported as null unless BOTH are set, deliberately:
# half a rate card produces a number that is wrong in a plausible direction, which is
# worse than no number. Thinking tokens are billed at the output rate.
RAGPIPE_PRICE_IN=
RAGPIPE_PRICE_OUT=

# ---- contextual retrieval (optional, built but never run) ------------------------
# Needs a metered model. Either a direct Anthropic key or Bedrock credentials.
ANTHROPIC_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=

# ---- fetching (optional) ---------------------------------------------------------
# Sent when downloading the corpus. Set it to something identifying you; the default is
# generic and the sources are public services being asked for a few hundred files.
RAGPIPE_USER_AGENT=
